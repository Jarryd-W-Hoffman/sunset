includes:
    - phpstan.neon

parameters:
    level: 5

    paths:
        - tests

    ignoreErrors:
        # ->note() is Route Notes' macro. Those tests only run when it's installed.
        -
            message: '#^Call to an undefined method Illuminate\\Routing\\Route::note\(\)\.$#'
            path: tests/Integration/RouteNotesTest.php
